# =============================================================================
# InterMUN — environment template (copy to .env.local for local development)
# Never commit real secrets. This file is safe to commit; .env.local is gitignored.
# =============================================================================

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
# Alternative key name supported by some Supabase dashboards:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key

# Server-only: admin scripts, cron jobs, user invites (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- App URL (required for invite links, emails, OAuth redirects) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Branding (optional) ---
# NEXT_PUBLIC_APP_NAME=InterMUN
# NEXT_PUBLIC_APP_TAGLINE=Model United Nations platform
# NEXT_PUBLIC_APP_DESCRIPTION=

# --- Partnership & commercial licensing (required for production marketing contact) ---
PARTNERSHIP_CONTACT_EMAIL=partnership@your-domain.example
# Client-visible contact (marketing pages); can match PARTNERSHIP_CONTACT_EMAIL
NEXT_PUBLIC_PARTNERSHIP_CONTACT_EMAIL=partnership@your-domain.example

# --- SMTP (optional — delegate materials export, allocation signup, inquiry relay) ---
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# MATERIALS_EXPORT_FROM="InterMUN <no-reply@your-domain.example>"

# --- Staff / ops (optional — set in production; leave unset to disable bypass) ---
# STAFF_COMMITTEE_BYPASS_PASSWORD=
# CHAIR_MULTI_COMMITTEE_TEST_EMAILS=dev@example.com

# --- Cron (optional — Vercel Cron / scheduled award submission processing) ---
# CRON_SECRET=generate_a_long_random_string

# --- Conference content (optional) ---
# NEXT_PUBLIC_SEAMUN_HANDBOOK_PDF_URL=https://your-cdn.example/handbook.pdf
# AWARD_SUBMISSION_DEADLINE_ISO=2027-01-17T23:59:59.000Z
